{
  "name": "nordlys-i-natt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nordlys i natt? — Aurora go/no-go for Norway, built on open NOAA + MET + Kartverket APIs.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @nordlys/api dev\" \"pnpm --filter @nordlys/web dev\""
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
