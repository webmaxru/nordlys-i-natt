<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (APNs). Xcode switches this to "production" when exporting for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: https://nordlys.salnikov.no/... opens in the app (apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:nordlys.salnikov.no</string>
	</array>
</dict>
</plist>
