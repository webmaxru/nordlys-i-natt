{
  "name": "@nordlys/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nordlys i natt? iOS + Android app (Capacitor shell around apps/web).",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "pnpm run build:web && cap sync",
    "sync:android": "pnpm run build:web && cap sync android",
    "sync:ios": "pnpm run build:web && cap sync ios",
    "assets": "npx --yes @capacitor/assets@3.0.5 generate --android --ios --iconBackgroundColor \"#0b1020\" --iconBackgroundColorDark \"#0b1020\" --splashBackgroundColor \"#0b1020\" --splashBackgroundColorDark \"#0b1020\"",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capacitor-community/admob": "^8.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
