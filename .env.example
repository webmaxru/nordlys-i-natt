# --- Backend (apps/api) ---
PORT=8080
# Identifying User-Agent sent to api.met.no (REQUIRED by MET Terms of Service).
# MET rejects obvious placeholders (e.g. anything with example.com). Use a real contact.
MET_USER_AGENT="nordlys-i-natt/1.0 your-contact@your-domain.no"
MET_CACHE_TTL_SECONDS=900
NOAA_CACHE_TTL_SECONDS=600

# Quiet hours: suppress push during these Europe/Oslo hours [start, end). Set start === end to disable.
QUIET_HOURS_START=2
QUIET_HOURS_END=6

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:contact@example.com"

# Subscription store: "file" (local JSON) or "table" (Azure Table Storage)
STORE_DRIVER=file
STORE_FILE_PATH=./data/subscriptions.json
AZURE_TABLE_CONNECTION_STRING=
AZURE_TABLE_NAME=subscriptions

# Application Insights (server) — optional locally
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Frontend (apps/web, must be prefixed VITE_) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_VAPID_PUBLIC_KEY=
VITE_APPINSIGHTS_CONNECTION_STRING=
