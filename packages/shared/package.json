    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@types/suncalc": "^1.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
